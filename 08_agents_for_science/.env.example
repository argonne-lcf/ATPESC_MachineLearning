# Model identifier served by the ALCF inference endpoint.
# Defaults to openai/gpt-oss-120b if unset. Ask the instructor for other options.
ALCF_MODEL=openai/gpt-oss-120b

# OpenAI-compatible ALCF inference endpoint.
ALCF_BASE_URL=https://inference-api.alcf.anl.gov/resource_server/sophia/vllm/v1

# OPTIONAL override. By default the tutorial fetches a Globus-issued token
# automatically via scripts/inference_auth_token.py (auto-refreshing it). Set
# this only to pin a specific token. Never commit the real value.
# ALCF_ACCESS_TOKEN=REPLACE_WITH_ACCESS_TOKEN

# OPTIONAL. Where MACE caches downloaded model weights. Defaults to
# <repo>/mace_models (set by activate.sh). Point this at a pre-staged or shared
# location to avoid re-downloading.
# MACE_CACHE_DIR=/lus/flare/projects/<project>/mace_models

# Required only for Example 3 on Aurora. This command runs in every Parsl worker;
# activate.sh already loads the frameworks module and the venv.
# ATPESC_AURORA_WORKER_INIT=source /path/to/repo/activate.sh; export TMPDIR=/tmp
